# Base URL the frontend uses to reach the FastAPI backend.
#
# Local development: the Next.js dev server runs on :3000 and the FastAPI
# backend runs on :8000, so this must point at the backend explicitly
# (http://localhost:8000). Copy this file to `.env.development.local` (which
# stays git-ignored) with that value to develop locally.
#
# Production: leave this empty. The static export is served same-origin by
# FastAPI (PLAN.md §3), so every request can use a relative /api/* path and
# no base URL is needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
