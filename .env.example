# Copy this file to `.env` in the repo root and fill in your own values.
# The backend loads the project-root .env without overriding any variable
# already present in the environment (see load_dotenv(..., override=False)
# in backend/app/main.py).

# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data
# If not set, the built-in market simulator is used (recommended for most users)
MASSIVE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false
